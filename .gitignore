# Build
/target
# Live supervisor copy (band 144) — cargo may overwrite target/debug/
/target/live/
**/*.exe
*.pdb

# Durable runtime store (tracker, omni config, ratio JSON)
/data/*
!/data/.gitkeep

# Runtime claim/event log (append-only, no secrets). The board is tickets.jsonl.
/docs/gsv/ticket_claims.jsonl

# Secrets
.env
.env.*
*.pem
*.key
secrets/

# IDE / OS
.idea/
*.swp
*.swo
Thumbs.db
.DS_Store

# OpenCode plugin install (kit package.json lives in .opencode/)
.opencode/node_modules/
.opencode/package-lock.json

# Local drain helpers (messages .md, logs .log). Only README.md is tracked.
/comitmsg/*
!/comitmsg/README.md
